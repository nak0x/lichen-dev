# Base du serveur ActivityPub wilder que ce client interroge.
# En local, c'est l'adresse par défaut sur laquelle wilder écoute.
WILDER_URL=http://127.0.0.1:8080

# Acteur affiché par défaut sur la page d'accueil (format @nom@domaine).
# Doit correspondre à un acteur servi par WILDER_URL (l'acteur de démo est
# « beaver-class »).
NUXT_PUBLIC_HOME_HANDLE=beaver-class@127.0.0.1:8080

# Nom d'affichage de l'instance.
NUXT_PUBLIC_INSTANCE_NAME=wilder
